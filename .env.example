# Everything is optional. With nothing set, gatekeep runs in demo mode:
# in-memory storage, seeded demo data, no login, no billing.
# In production (NODE_ENV=production) demo mode must be enabled explicitly:
GATEKEEP_DEMO=

# Public URL of this deployment (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: logs, projects, API keys, dashboard auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 after enabling the GitHub provider in Supabase Auth: shows "Continue with GitHub" on /login
NEXT_PUBLIC_SUPABASE_GITHUB=

# Optional: run the store conformance suite against a throwaway Supabase project (never production).
# Without these the Supabase half of the suite is skipped.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=

# Upstash Redis: velocity / burst counters (falls back to Postgres counts, then memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
